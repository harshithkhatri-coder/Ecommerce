# Backend Environment Variables
# Copy this file to ".env" and fill in the real values for local development.
# For Vercel hosting, set these in the Vercel Dashboard > Project > Settings > Environment Variables.

PORT=5000
JWT_SECRET=velux_kicks_secret_key_2024

# Supabase credentials - get these from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# IMPORTANT: SUPABASE_ANON_KEY must be the JWT "anon public" key (starts with "eyJ...").
# It is NOT a URL. Do NOT put "https://...supabase.co/rest/v1/" here.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Admin credentials
ADMIN_EMAIL=admin@veluxkicks.com
ADMIN_PASSWORD=admin@12341