# Frontend Environment Variables
# Copy this file to ".env" and fill in the real values for local development.
# For Vercel hosting, set these in the Vercel Dashboard > Project > Settings > Environment Variables.

# API base URL - only needed for local development.
# In production (Vercel), leave this UNSET so the app uses relative "/api" routes (same-origin).
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Supabase credentials - get these from Supabase Dashboard > Project Settings > API
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
# IMPORTANT: Set this to the real Supabase "anon public" key (starts with "eyJ...").
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here